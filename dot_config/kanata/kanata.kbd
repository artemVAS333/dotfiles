(defcfg
    process-unmapped-keys yes    
)

(defsrc)

(defvar
    tap-time        170
    hold-time       170
    double-tap-time 300
    
    left-hand-keys (
        q w e r t
        a s d f g
        z x c v b
    )
  
    right-hand-keys (
        y u i o p
        h j k l ;
        n m , . /
    )

    ;;------------------------------------------------------------------
    key1 a
    mod1 lctl

    key2 s
    mod2 lalt

    key3 d
    mod3 lsft

    key4 f
    mod4 lmet

    rkey1 j
    rmod1 rmet

    rkey2 k
    rmod2 rsft

    rkey3 l
    rmod3 ralt

    rkey4 ;
    rmod4 rctl

    ;;------------------------------------------------------------------
    th1-key lalt
    th1-tap esc
    th1-hold (layer-toggle num-layer)

    th2-key lmet
    th2-tap spc
    th2-hold lmet

    th3-key spc
    th3-tap ent
    th3-hold (layer-toggle edit-layer)

    th4-key rmet
    th4-tap tab
    th4-hold (layer-toggle fn-layer)
)

(defalias
    tap (multi
        (layer-switch nomods)
        (on-idle-fakekey to-base tap 20)
    )

    ;; Home Row Mods
    alfa   (tap-hold-release-keys $tap-time $hold-time (multi $key1 @tap) $mod1 $left-hand-keys)
    beta   (tap-hold-release-keys $tap-time $hold-time (multi $key2 @tap) $mod2 $left-hand-keys)
    gamma  (tap-hold-release-keys $tap-time $hold-time (multi $key3 @tap) $mod3 $left-hand-keys)
    delta  (tap-hold-release-keys $tap-time $hold-time (multi $key4 @tap) $mod4 $left-hand-keys)
    
    ralfa  (tap-hold-release-keys $tap-time $hold-time (multi $rkey1 @tap) $rmod1 $right-hand-keys)
    rbeta  (tap-hold-release-keys $tap-time $hold-time (multi $rkey2 @tap) $rmod2 $right-hand-keys)
    rgamma (tap-hold-release-keys $tap-time $hold-time (multi $rkey3 @tap) $rmod3 $right-hand-keys)
    rdelta (tap-hold-release-keys $tap-time $hold-time (multi $rkey4 @tap) $rmod4 $right-hand-keys)

    ;; Thumb Keys
    thumb-1 (tap-hold $tap-time $hold-time $th1-tap $th1-hold)
    thumb-2 (tap-hold $tap-time $hold-time $th2-tap $th2-hold)
    thumb-3 (tap-hold $tap-time $hold-time $th3-tap $th3-hold)
    thumb-4 (tap-hold $tap-time $hold-time $th4-tap $th4-hold)
)

(deffakekeys
    to-base (layer-switch base)
)

(deflayermap (base)
    $key1 @alfa
    $key2 @beta
    $key3 @gamma
    $key4 @delta

    $rkey1 @ralfa
    $rkey2 @rbeta
    $rkey3 @rgamma
    $rkey4 @rdelta

    $th1-key @thumb-1
    $th2-key @thumb-2
    $th3-key @thumb-3
    $th4-key @thumb-4
)

(deflayermap (nomods)
    $key1 $key1
    $key2 $key2
    $key3 $key3
    $key4 $key4

    $rkey1 $rkey1
    $rkey2 $rkey2
    $rkey3 $rkey3
    $rkey4 $rkey4

    $th1-key @thumb-1
    $th2-key @thumb-2
    $th3-key @thumb-3
    $th4-key @thumb-4
)

(deflayermap (edit-layer)
    $key1 $mod1
    $key2 $mod2
    $key3 $mod3
    $key4 $mod4

    i bspc
    o del

    e A-right
    b A-left

    p C-S-tab   
    n C-tab     

    h lft     
    j down     
    k up       
    l rght     
)

(deflayermap (fn-layer)
    h prev
    j voldwn
    k volu
    l next
    p pp
    m mute

    i brdn    
    o brup    

    q f12    w f9    e f8    r f7
    a f11    s f6    d f5    f f4
    z f10    x f3    c f2    v f1
)

(deflayermap (num-layer)
    $key1 $mod1
    $key2 $mod2
    $key3 $mod3
    $key4 $mod4

    y [     u 7     i 8     o 9     p ]     
    h =     j 4     k 5     l 6     ; '
    n -     m 1     , 2     . 3     / \

    $th3-key 0   
    $th4-key `   
)

