(defcfg
  process-unmapped-keys yes
)

(defsrc)

(defalias
  cap (tap-hold 200 200 esc lctl)
  spc-nav (tap-hold-press 200 200 spc (layer-toggle nav))

  m-c M-c    ;; Copy
  m-v M-v    ;; Paste
  m-z M-z    ;; Undo
  m-f M-f    ;; Find
  m-x M-x    ;; Cut
)

(deflayermap (base)
  caps @cap
  spc  @spc-nav
  lctl fn
  fn XX

  f1   brdn          ;; Brightness Down
  f2   brup          ;; Brightness Up
  f7   prev          ;; Media Previous
  f8   pp            ;; Media Play / Pause
  f9   next          ;; Media Next
  f10  mute          ;; Volume Mute
  f11  vold          ;; Volume Down
  f12  volu          ;; Volume Up
)

(deflayermap (nav)
  h left
  j down
  k up
  l right

  w A-right 
  b A-left 
  n home   
  . end    

  m pgdn   
  , pgup  

  u @m-z   
  y @m-c   
  p @m-v   
  x @m-x   
  f @m-f   

  bspc A-bspc

  i C-S-tab
  o C-tab
)
