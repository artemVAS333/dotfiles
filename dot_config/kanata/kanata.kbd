(defcfg
    process-unmapped-keys yes    
)

(defsrc)

(defvar
    tap-time        170
    hold-time       170
    double-tap-time 300
    
    left-hand-keys (
        q w e r t
        a s d f g
        z x c v b
    )
  
    right-hand-keys (
        y u i o p
        h j k l ;
        n m , . /
    )

    ;;------------------------------------------------------------------
    key1 a
    mod1 lctl

    key2 s
    mod2 lalt

    key3 d
    mod3 lsft

    key4 f
    mod4 lmet

    rkey1 j
    rmod1 rmet

    rkey2 k
    rmod2 rsft

    rkey3 l
    rmod3 ralt

    rkey4 ;
    rmod4 rctl

    ;;------------------------------------------------------------------
    th1-key lalt 
    th1-tap esc
    th1-hold wm-layer

    th2-key lmet 
    th2-tap spc 
    th2-hold edit-layer

    th3-key spc 
    th3-tap ent 
    th3-hold num-layer

    th4-key rmet
    th4-tap tab 
    th4-hold fn-layer
)

(defalias
    tap (multi
        (layer-switch nomods)
        (on-idle-fakekey to-base tap 20)
    )

    ;; Home Row Mods
    alfa   (tap-hold-release-keys $tap-time $hold-time (multi $key1 @tap) $mod1 $left-hand-keys)
    beta   (tap-hold-release-keys $tap-time $hold-time (multi $key2 @tap) $mod2 $left-hand-keys)
    gamma  (tap-hold-release-keys $tap-time $hold-time (multi $key3 @tap) $mod3 $left-hand-keys)
    delta  (tap-hold-release-keys $tap-time $hold-time (multi $key4 @tap) $mod4 $left-hand-keys)
    
    ralfa  (tap-hold-release-keys $tap-time $hold-time (multi $rkey1 @tap) $rmod1 $right-hand-keys)
    rbeta  (tap-hold-release-keys $tap-time $hold-time (multi $rkey2 @tap) $rmod2 $right-hand-keys)
    rgamma (tap-hold-release-keys $tap-time $hold-time (multi $rkey3 @tap) $rmod3 $right-hand-keys)
    rdelta (tap-hold-release-keys $tap-time $hold-time (multi $rkey4 @tap) $rmod4 $right-hand-keys)

    ;; Thumb Keys
    thumb-1 (tap-hold $tap-time $hold-time $th1-tap (layer-toggle $th1-hold))
    thumb-2 (tap-hold $tap-time $hold-time $th2-tap (layer-toggle $th2-hold))
    thumb-3 (tap-hold $tap-time $hold-time $th3-tap (layer-toggle $th3-hold))
    thumb-4 (tap-hold $tap-time $hold-time $th4-tap (layer-toggle $th4-hold))
)

(deffakekeys
    to-base (layer-switch base)
)

(deflayermap (base)
    $key1 @alfa
    $key2 @beta
    $key3 @gamma
    $key4 @delta

    $rkey1 @ralfa
    $rkey2 @rbeta
    $rkey3 @rgamma
    $rkey4 @rdelta

    $th1-key @thumb-1
    $th2-key @thumb-2
    $th3-key @thumb-3
    $th4-key @thumb-4
)

(deflayermap (nomods)
    $key1 $key1
    $key2 $key2
    $key3 $key3
    $key4 $key4

    $rkey1 $rkey1
    $rkey2 $rkey2
    $rkey3 $rkey3
    $rkey4 $rkey4

    $th1-key @thumb-1
    $th2-key @thumb-2
    $th3-key @thumb-3
    $th4-key @thumb-4
)

(deflayermap (edit-layer)
    ;;$key1 $mod1
    $key2 $mod2
    $key3 $mod3
    $key4 $mod4

    i bspc
    o del

    e A-right
    w A-left

    a M-a       ;; Select All
    y M-c       ;; Copy 
    c M-c       ;; Copy
    u M-z       ;; Undo
    z M-z       ;; Undo
    r M-S-z     ;; Redo
    b M-S-z     ;; Redo
    x M-x       ;; Cut 
    p M-v       ;; Paste 
    v M-v       ;; Paste

    h lft       ;; Left
    j down      ;; Down
    k up        ;; Up
    l rght      ;; Right

    / ins       ;; Insert
    n home      ;; Home
    m pgdn      ;; Page Down
    , pgup      ;; Page Up
    . end       ;; End

    t M-t

    $th3-key C-S-tab     ;; Tab
    $th4-key C-tab   ;; Shift + Tab
)

(deflayermap (wm-layer)
    $key1 $mod1
    $key2 $mod2

    n C-S-A-M-n
    d C-S-A-M-d

    h M-S-h
    j M-S-j
    k M-S-k
    l M-S-l

    m M-S-1
    , M-S-2
    . M-S-3
    p M-S-4
    ; M-S-5
    / M-S-6

    i M-S-i
    o M-S-o

    t C-M-t
    e C-M-e

    q M-q
    f C-M-f
    c C-M-c
    x C-M-x

    g C-S-A-M-g
    b C-S-A-M-b
    y C-S-A-M-y
)

(deflayermap (fn-layer)
    h prev
    j voldwn
    k volu
    l next
    p pp
    m mute

    i brdn    
    o brup    

    q f12    w f5    e f6    r f7     t f10
    a f11    s f4    d f3    f f1     g f2
                     c f9    v f8    
)

(deflayermap (num-layer)
    $rkey1 $rmod1
    $rkey2 $rmod2
    $rkey3 $rmod3
    $rkey4 $rmod4

    q [     w 5     e 6     r 7     t ]     
    a '     s 4     d 3     f 1     g 2
    z \     x -     c 9     v 8     b =

    $th1-key `   
    $th2-key 0   
)

