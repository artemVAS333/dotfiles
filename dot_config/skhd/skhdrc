# create desktop, move window and follow focus - uses jq for parsing json (brew install jq)
# shift + alt - n : yabai -m space --create && \
#                   index="$(yabai -m query --spaces --display | jq 'map(select(."is-native-fullscreen" == false))[-1].index')" && \
#                   yabai -m window --space "${index}" && \
#                   yabai -m space --focus "${index}"

# Focus spaces
# cmd + shift - comma  : yabai -m space --focus prev || yabai -m space --focus last 
# cmd + shift - period : yabai -m space --focus next || yabai -m space --focus first
# cmd + shift - [ : yabai -m space --focus prev || yabai -m space --focus last
cmd + shift - 1 : yabai -m space --focus 1
cmd + shift - 2 : yabai -m space --focus 2
cmd + shift - 3 : yabai -m space --focus 3
cmd + shift - 4 : yabai -m space --focus 4
cmd + shift - 5 : yabai -m space --focus 5
cmd + shift - 6 : yabai -m space --focus 6
cmd + shift - 7 : yabai -m space --focus 7
cmd + shift - 8 : yabai -m space --focus 8
cmd + shift - 9 : yabai -m space --focus 9

# Focus displays
rcmd + shift - 1 : yabai -m display --focus 1
rcmd + shift - 2 : yabai -m display --focus 2 
rcmd + shift - 3 : yabai -m display --focus 3
rcmd + shift - 4 : yabai -m display --focus 4
rcmd + shift - 5 : yabai -m display --focus 5
rcmd + shift - 6 : yabai -m display --focus 6
rcmd + shift - 7 : yabai -m display --focus 7
rcmd + shift - 8 : yabai -m display --focus 8
rcmd + shift - 9 : yabai -m display --focus 9

# Move focused window to space 
alt + shift - 1 : yabai -m window --space 1 && yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2 && yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3 && yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4 && yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5 && yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space 6 && yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space 7 && yabai -m space --focus 7
alt + shift - 8 : yabai -m window --space 8 && yabai -m space --focus 8
alt + shift - 9 : yabai -m window --space 9 && yabai -m space --focus 9

# Move focused window to display 
alt + rcmd - 1 : yabai -m window --display 1 && yabai -m display --focus 1
alt + rcmd - 2 : yabai -m window --display 2 && yabai -m display --focus 2
alt + rcmd - 3 : yabai -m window --display 3 && yabai -m display --focus 3
alt + rcmd - 4 : yabai -m window --display 4 && yabai -m display --focus 4
alt + rcmd - 5 : yabai -m window --display 5 && yabai -m display --focus 5
alt + rcmd - 6 : yabai -m window --display 6 && yabai -m display --focus 6
alt + rcmd - 7 : yabai -m window --display 7 && yabai -m display --focus 7
alt + rcmd - 8 : yabai -m window --display 8 && yabai -m display --focus 8
alt + rcmd - 9 : yabai -m window --display 9 && yabai -m display --focus 9

# Focus windows
cmd + shift - o : yabai -m window --focus recent || yabai -m display --focus recent
cmd + shift - h : yabai -m window --focus west  || yabai -m display --focus west
cmd + shift - j : yabai -m window --focus south || yabai -m display --focus south
cmd + shift - k : yabai -m window --focus north || yabai -m display --focus north
cmd + shift - l : yabai -m window --focus east  || yabai -m display --focus east

# Move windows directionally / move floating window
alt + shift - h : ~/.config/yabai/scripts/move_window.sh west
alt + shift - j : ~/.config/yabai/scripts/move_window.sh south
alt + shift - k : ~/.config/yabai/scripts/move_window.sh north
alt + shift - l : ~/.config/yabai/scripts/move_window.sh east

# Resize windows
alt + cmd - h : yabai -m window --resize right:-40:0 || yabai -m window --resize left:-40:0
alt + cmd - j : yabai -m window --resize bottom:0:40|| yabai -m window --resize top:0:40
alt + cmd - k : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40
alt + cmd - l : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0

# Swap window
ctrl + cmd - h : yabai -m window --swap west  || yabai -m window --display west  && yabai -m display --focus west
ctrl + cmd - j : yabai -m window --swap south || yabai -m window --display south && yabai -m display --focus south
ctrl + cmd - k : yabai -m window --swap north || yabai -m window --display north && yabai -m display --focus north
ctrl + cmd - l : yabai -m window --swap east  || yabai -m window --display east  && yabai -m display --focus east

# Set insertion point in focused container
ctrl + shift - h : yabai -m window --insert west
ctrl + shift - j : yabai -m window --insert south
ctrl + shift - k : yabai -m window --insert north
ctrl + shift - l : yabai -m window --insert east

# Manage window 
shift + alt - f : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
shift + alt - c : ~/.config/yabai/scripts/center_window.sh
shift + alt - m : ~/.config/yabai/scripts/toggle_minimize.sh
shift + alt - x : yabai -m window --close

# Manage window layout
shift + alt - 0 : yabai -m space --balance

# Manage window mode 
alt - e : yabai -m window --toggle split
alt - t : yabai -m window --toggle float 

# Manage window layout
# shift + alt - b : yabai -m space --layout bsp
# shift + alt - f : yabai -m space --layout float
# shift + alt - s : yabai -m space --layout stack

# App launchers
ctrl - space   : ~/.config/yabai/scripts/launch.sh ~/.config/yabai/scripts/launcher.sh launcher-term
ctrl - return  : ~/.config/yabai/scripts/launch.sh zsh my-term 
ctrl + cmd - e : ~/.config/yabai/scripts/launch.sh yazi
ctrl + cmd - b : ~/.config/yabai/scripts/launch.sh btop
ctrl + cmd - r : yabai --restart-service

