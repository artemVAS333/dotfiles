# Create desktop, move window and follow focus 
ctrl + shift - 0x02 : yabai -m space --destroy                          # d
ctrl + shift - 0x2D : ~/.config/yabai/scripts/create_space.sh           # n

# Change focus space
ctrl - left  : mkdir /tmp/yabai_space.lock 2>/dev/null && { yabai -m space --focus prev || yabai -m space --focus last;  sleep 0.1; rmdir /tmp/yabai_space.lock; }
ctrl - right : mkdir /tmp/yabai_space.lock 2>/dev/null && { yabai -m space --focus next || yabai -m space --focus first; sleep 0.1; rmdir /tmp/yabai_space.lock; }

ctrl - 1 : yabai -m space --focus 1  
ctrl - 2 : yabai -m space --focus 2  
ctrl - 3 : yabai -m space --focus 3  
ctrl - 4 : yabai -m space --focus 4 
ctrl - 5 : yabai -m space --focus 5  
ctrl - 6 : yabai -m space --focus 6  
ctrl - 7 : yabai -m space --focus 7  
ctrl - 8 : yabai -m space --focus 8  
ctrl - 9 : yabai -m space --focus 9  
ctrl - 0 : yabai -m space --focus 10 

# Move focused window to space 
ctrl + shift - left : mkdir /tmp/yabai_space.lock 2>/dev/null && { \
  trap 'rmdir /tmp/yabai_space.lock' EXIT; \
  yabai -m window --space prev || yabai -m window --space last; \
  yabai -m space --focus prev || yabai -m space --focus last; \
  sleep 0.15; \
}

ctrl + shift - right : mkdir /tmp/yabai_space.lock 2>/dev/null && { \
  trap 'rmdir /tmp/yabai_space.lock' EXIT; \
  yabai -m window --space next || yabai -m window --space first; \
  yabai -m space --focus next || yabai -m space --focus first; \
  sleep 0.15; \
}

ctrl + shift - 1 : yabai -m window --space 1  && yabai -m space --focus 1
ctrl + shift - 2 : yabai -m window --space 2  && yabai -m space --focus 2
ctrl + shift - 3 : yabai -m window --space 3  && yabai -m space --focus 3
ctrl + shift - 4 : yabai -m window --space 4  && yabai -m space --focus 4
ctrl + shift - 5 : yabai -m window --space 5  && yabai -m space --focus 5
ctrl + shift - 6 : yabai -m window --space 6  && yabai -m space --focus 6
ctrl + shift - 7 : yabai -m window --space 7  && yabai -m space --focus 7
ctrl + shift - 8 : yabai -m window --space 8  && yabai -m space --focus 8
ctrl + shift - 9 : yabai -m window --space 9  && yabai -m space --focus 9
ctrl + shift - 0 : yabai -m window --space 10 && yabai -m space --focus 10

# Focus windows
cmd + ctrl - 0x04 : yabai -m window --focus west  || yabai -m display --focus west   # h
cmd + ctrl - 0x26 : yabai -m window --focus south || yabai -m display --focus south  # j
cmd + ctrl - 0x28 : yabai -m window --focus north || yabai -m display --focus north  # k
cmd + ctrl - 0x25 : yabai -m window --focus east  || yabai -m display --focus east   # l

# Move windows directionally / move floating window
cmd + shift - 0x04 : ~/.config/yabai/scripts/move_window.sh west   # h
cmd + shift - 0x26 : ~/.config/yabai/scripts/move_window.sh south  # j
cmd + shift - 0x28 : ~/.config/yabai/scripts/move_window.sh north  # k
cmd + shift - 0x25 : ~/.config/yabai/scripts/move_window.sh east   # l

# Swap window
cmd + shift - left  : yabai -m window --swap west  || yabai -m window --display west  && yabai -m display --focus west
cmd + shift - down  : yabai -m window --swap south || yabai -m window --display south && yabai -m display --focus south
cmd + shift - up    : yabai -m window --swap north || yabai -m window --display north && yabai -m display --focus north
cmd + shift - right : yabai -m window --swap east  || yabai -m window --display east  && yabai -m display --focus east

# Resize windows
cmd + alt - 0x04 : yabai -m window --resize right:-40:0  || yabai -m window --resize left:-40:0   # h
cmd + alt - 0x26 : yabai -m window --resize bottom:0:40  || yabai -m window --resize top:0:40     # j
cmd + alt - 0x28 : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40    # k
cmd + alt - 0x25 : yabai -m window --resize right:40:0   || yabai -m window --resize left:40:0    # l

# Manage window 
cmd + alt - 0x01 : yabai -m window --toggle split                                        # s
cmd + alt - 0x11 : yabai -m window --toggle float                                        # t
cmd + alt - 0x03 : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen # f
cmd + alt - 0x08 : ~/.config/yabai/scripts/center_window.sh                              # c
cmd + alt - 0x07 : yabai -m window --close                                               # x

# Modify window tree
ctrl + alt - 0 : yabai -m space --balance
ctrl + alt - 1 : yabai -m space --mirror x-axis
ctrl + alt - 2 : yabai -m space --mirror y-axis
ctrl + alt - 3 : yabai -m space --rotate 90

# App launchers
hyper - 0x10 : ~/.config/yabai/scripts/launch.sh yazi   # y
hyper - 0x0B : ~/.config/yabai/scripts/launch.sh btop   # b

cmd - 0x2E : :   # m
cmd - 0x04 : :   # h
