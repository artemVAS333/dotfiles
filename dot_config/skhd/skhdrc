# focus monitor
# ctrl + alt - z  : yabai -m display --focus prev
# ctrl + alt - 3  : yabai -m display --focus 3

# send window to monitor and follow focus
# ctrl + cmd - c  : yabai -m window --display next; yabai -m display --focus next
# ctrl + cmd - 1  : yabai -m window --display 1; yabai -m display --focus 1
# ctrl + cmd - 2  : yabai -m window --display 2; yabai -m display --focus 2

# Set insertion point in focused container
ctrl + alt - h : yabai -m window --insert west
ctrl + alt - j : yabai -m window --insert south
ctrl + alt - k : yabai -m window --insert north
ctrl + alt - l : yabai -m window --insert east

# Manage window mode 
alt - e : yabai -m window --toggle split
alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2
alt - p : yabai -m window --toggle sticky --toggle pip

# Toggle spaces 
shift + cmd - r : yabai -m space --focus recent
shift + cmd - 1 : yabai -m space --focus 1
shift + cmd - 2 : yabai -m space --focus 2
shift + cmd - 3 : yabai -m space --focus 3
shift + cmd - 4 : yabai -m space --focus 4
shift + cmd - 5 : yabai -m space --focus 5
shift + cmd - 6 : yabai -m space --focus 6
shift + cmd - 7 : yabai -m space --focus 7
shift + cmd - 8 : yabai -m space --focus 8
shift + cmd - 9 : yabai -m space --focus 9

# Focus windows
shift + cmd - o : yabai -m window --focus next  || yabai -m window --focus first
shift + cmd - i : yabai -m window --focus prev  || yabai -m window --focus last
shift + cmd - h : yabai -m window --focus west  || yabai -m window --focus east   || yabai -m window --grid 1:2:0:0:1:1
shift + cmd - j : yabai -m window --focus south || yabai -m window --focus north  || yabai -m window --grid 2:1:0:1:1:1
shift + cmd - k : yabai -m window --focus north || yabai -m window --focus south  || yabai -m window --grid 2:1:0:0:1:1
shift + cmd - l : yabai -m window --focus east  || yabai -m window --focus west   || yabai -m window --grid 1:2:1:0:1:1

# Move focused window to Space
shift + alt - n : yabai -m window --space next; yabai -m space --focus next
shift + alt - p : yabai -m window --space prev; yabai -m space --focus next
shift + alt - 1 : yabai -m window --space 1 && yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2 && yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3 && yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4 && yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5 && yabai -m space --focus 5
shift + alt - 6 : yabai -m window --space 6 && yabai -m space --focus 6
shift + alt - 7 : yabai -m window --space 7 && yabai -m space --focus 7
shift + alt - 8 : yabai -m window --space 8 && yabai -m space --focus 8
shift + alt - 9 : yabai -m window --space 9 && yabai -m space --focus 9

# Manage window layout
shift + alt - 0 : yabai -m space --balance
shift + alt - f : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
shift + alt - c : ~/.config/yabai/scripts/center_window.sh
shift + alt - m : ~/.config/yabai/scripts/toggle_minimize.sh
shift + alt - x : yabai -m window --close
shift + alt - q : ~/.config/yabai/scripts/quit_window.sh

# Resize windows
shift + alt - h : yabai -m window --resize left:-40:0 || yabai -m window --resize right:-40:0
shift + alt - j : yabai -m window --resize bottom:0:40|| yabai -m window --resize top:0:40
shift + alt - k : yabai -m window --resize top:0:-40  || yabai -m window --resize bottom:0:-40
shift + alt - l : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0
shift + cmd + alt - h : yabai -m window --resize right:-40:0
shift + cmd + alt - j : yabai -m window --resize top:0:40
shift + cmd + alt - k : yabai -m window --resize bottom:0:-40
shift + cmd + alt - l : yabai -m window --resize left:40:0

# Swap windows
ctrl + cmd - h : yabai -m window --swap west 
ctrl + cmd - j : yabai -m window --swap south
ctrl + cmd - k : yabai -m window --swap north
ctrl + cmd - l : yabai -m window --swap east

# Move windows directionally / move floating window
ctrl + shift - h : yabai -m window --warp west  || yabai -m window --move rel:-20:0
ctrl + shift - j : yabai -m window --warp south || yabai -m window --move rel:0:20
ctrl + shift - k : yabai -m window --warp north || yabai -m window --move rel:0:-20
ctrl + shift - l : yabai -m window --warp east  || yabai -m window --move rel:20:0

# app launchers
shift + cmd - e : ~/.config/yabai/scripts/launch_floating.sh yazi
shift + cmd - b : ~/.config/yabai/scripts/launch_floating.sh btop
ctrl - space : ~/.config/yabai/scripts/launch_floating.sh ~/.config/yabai/scripts/launcher.sh launcher-term
