# Create desktop, move window and follow focus 
ctrl + cmd - t  : yabai -m space --create && \
                    index="$(yabai -m query --spaces --display | jq 'map(select(."is-native-fullscreen" == false))[-1].index')" && \
                    yabai -m window --space "${index}" && \
                    yabai -m space --focus "${index}"
ctrl + cmd - w : yabai -m space --destroy

ctrl + shift - h : ~/.config/yabai/scripts/move_space.sh west
ctrl + shift - l : ~/.config/yabai/scripts/move_space.sh east
ctrl + shift - k : ~/.config/yabai/scripts/move_space.sh north
ctrl + shift - j : ~/.config/yabai/scripts/move_space.sh south

# Focus spaces
ctrl + cmd - r : yabai -m space --focus recent 
ctrl + cmd - i : yabai -m space --focus prev || yabai -m space --focus last
ctrl + cmd - o : yabai -m space --focus next || yabai -m space --focus first

ctrl + cmd - 1 : yabai -m space --focus 1  || yabai -m space --focus recent
ctrl + cmd - 2 : yabai -m space --focus 2  || yabai -m space --focus recent
ctrl + cmd - 3 : yabai -m space --focus 3  || yabai -m space --focus recent
ctrl + cmd - 4 : yabai -m space --focus 4  || yabai -m space --focus recent                    
ctrl + cmd - 5 : yabai -m space --focus 5  || yabai -m space --focus recent                    
ctrl + cmd - 6 : yabai -m space --focus 6  || yabai -m space --focus recent                    
ctrl + cmd - 7 : yabai -m space --focus 7  || yabai -m space --focus recent                    
ctrl + cmd - 8 : yabai -m space --focus 8  || yabai -m space --focus recent                    
ctrl + cmd - 9 : yabai -m space --focus 9  || yabai -m space --focus recent                    
ctrl + cmd - 0 : yabai -m space --focus 10 || yabai -m space --focus recent

# Move focused window to space 
shift + cmd - 1 : yabai -m window --space 1 && yabai -m space --focus 1
shift + cmd - 2 : yabai -m window --space 2 && yabai -m space --focus 2
shift + cmd - 3 : yabai -m window --space 3 && yabai -m space --focus 3
shift + cmd - 4 : yabai -m window --space 4 && yabai -m space --focus 4
shift + cmd - 5 : yabai -m window --space 5 && yabai -m space --focus 5
shift + cmd - 6 : yabai -m window --space 6 && yabai -m space --focus 6
shift + cmd - 7 : yabai -m window --space 7 && yabai -m space --focus 7
shift + cmd - 8 : yabai -m window --space 8 && yabai -m space --focus 8
shift + cmd - 9 : yabai -m window --space 9 && yabai -m space --focus 9

# Focus windows
ctrl + cmd - h : yabai -m window --focus west   || yabai -m display --focus west
ctrl + cmd - j : yabai -m window --focus south  || yabai -m display --focus south
ctrl + cmd - k : yabai -m window --focus north  || yabai -m display --focus north
ctrl + cmd - l : yabai -m window --focus east   || yabai -m display --focus east

# Move windows directionally / move floating window
shift + cmd - h : ~/.config/yabai/scripts/move_window.sh west
shift + cmd - j : ~/.config/yabai/scripts/move_window.sh south
shift + cmd - k : ~/.config/yabai/scripts/move_window.sh north
shift + cmd - l : ~/.config/yabai/scripts/move_window.sh east

# Resize windows
ctrl + alt - h : yabai -m window --resize right:-40:0 || yabai -m window --resize left:-40:0
ctrl + alt - j : yabai -m window --resize bottom:0:40|| yabai -m window --resize top:0:40
ctrl + alt - k : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40
ctrl + alt - l : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0

# Swap window
shift + alt - h : yabai -m window --swap west  || yabai -m window --display west  && yabai -m display --focus west
shift + alt - j : yabai -m window --swap south || yabai -m window --display south && yabai -m display --focus south
shift + alt - k : yabai -m window --swap north || yabai -m window --display north && yabai -m display --focus north
shift + alt - l : yabai -m window --swap east  || yabai -m window --display east  && yabai -m display --focus east

# Set insertion point in focused container
fn + cmd - h : yabai -m window --insert west
fn + cmd - j : yabai -m window --insert south
fn + cmd - k : yabai -m window --insert north
fn + cmd - l : yabai -m window --insert east

# Manage window 
ctrl + cmd - z : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
ctrl + cmd - f : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
ctrl + cmd - c : ~/.config/yabai/scripts/center_window.sh
ctrl + cmd - m : ~/.config/yabai/scripts/toggle_minimize.sh
ctrl + cmd - x : yabai -m window --close

# Manage window layout
# ctrl + cmd -  : yabai -m space --balance

# Manage window mode 
ctrl + cmd - e : yabai -m window --toggle split
ctrl + cmd - f : yabai -m window --toggle float 

# Manage window layout
# shift + alt - b : yabai -m space --layout bsp
# shift + alt - f : yabai -m space --layout float
# shift + alt - s : yabai -m space --layout stack

# App launchers
fn - space   : ~/.config/yabai/scripts/launch.sh ~/.config/yabai/scripts/launcher.sh launcher-term
fn - o  : ~/.config/yabai/scripts/launch.sh zsh my-term 
fn - y : ~/.config/yabai/scripts/launch.sh yazi
fn - b : ~/.config/yabai/scripts/launch.sh btop
fn - r : yabai --restart-service && skhd --restart-service

cmd - h : true
cmd - m : true
ctrl + cmd - m : true
# cmd - q : true 
