# Create desktop, move window and follow focus 
hyper - d : yabai -m space --destroy
hyper - n : ~/.config/yabai/scripts/create_space.sh

# Change focus space
ctrl - left  : mkdir /tmp/yabai_space.lock 2>/dev/null && { yabai -m space --focus prev || yabai -m space --focus last;  sleep 0.1; rmdir /tmp/yabai_space.lock; }
ctrl - right : mkdir /tmp/yabai_space.lock 2>/dev/null && { yabai -m space --focus next || yabai -m space --focus first; sleep 0.1; rmdir /tmp/yabai_space.lock; }

ctrl - 1 : yabai -m space --focus 1  
ctrl - 2 : yabai -m space --focus 2  
ctrl - 3 : yabai -m space --focus 3  
ctrl - 4 : yabai -m space --focus 4 
ctrl - 5 : yabai -m space --focus 5  
ctrl - 6 : yabai -m space --focus 6  
ctrl - 7 : yabai -m space --focus 7  
ctrl - 8 : yabai -m space --focus 8  
ctrl - 9 : yabai -m space --focus 9  
ctrl - 0 : yabai -m space --focus 10 

# Move focused window to space 
ctrl + shift - left : mkdir /tmp/yabai_space.lock 2>/dev/null && { \
  trap 'rmdir /tmp/yabai_space.lock' EXIT; \
  yabai -m window --space prev || yabai -m window --space last; \
  yabai -m space --focus prev || yabai -m space --focus last; \
  sleep 0.15; \
}

ctrl + shift - right : mkdir /tmp/yabai_space.lock 2>/dev/null && { \
  trap 'rmdir /tmp/yabai_space.lock' EXIT; \
  yabai -m window --space next || yabai -m window --space first; \
  yabai -m space --focus next || yabai -m space --focus first; \
  sleep 0.15; \
}

ctrl + shift - 1 : yabai -m window --space 1  && yabai -m space --focus 1
ctrl + shift - 2 : yabai -m window --space 2  && yabai -m space --focus 2
ctrl + shift - 3 : yabai -m window --space 3  && yabai -m space --focus 3
ctrl + shift - 4 : yabai -m window --space 4  && yabai -m space --focus 4
ctrl + shift - 5 : yabai -m window --space 5  && yabai -m space --focus 5
ctrl + shift - 6 : yabai -m window --space 6  && yabai -m space --focus 6
ctrl + shift - 7 : yabai -m window --space 7  && yabai -m space --focus 7
ctrl + shift - 8 : yabai -m window --space 8  && yabai -m space --focus 8
ctrl + shift - 9 : yabai -m window --space 9  && yabai -m space --focus 9
ctrl + shift - 0 : yabai -m window --space 10 && yabai -m space --focus 10

# Focus windows
cmd + ctrl - h : yabai -m window --focus west  || yabai -m display --focus west
cmd + ctrl - j : yabai -m window --focus south || yabai -m display --focus south
cmd + ctrl - k : yabai -m window --focus north || yabai -m display --focus north
cmd + ctrl - l : yabai -m window --focus east  || yabai -m display --focus east

# Move windows directionally / move floating window
cmd + shift - h : ~/.config/yabai/scripts/move_window.sh west
cmd + shift - j : ~/.config/yabai/scripts/move_window.sh south
cmd + shift - k : ~/.config/yabai/scripts/move_window.sh north
cmd + shift - l : ~/.config/yabai/scripts/move_window.sh east

# Resize windows
cmd + alt - h : yabai -m window --resize right:-40:0  || yabai -m window --resize left:-40:0
cmd + alt - j : yabai -m window --resize bottom:0:40  || yabai -m window --resize top:0:40
cmd + alt - k : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40
cmd + alt - l : yabai -m window --resize right:40:0   || yabai -m window --resize left:40:0

# Swap window
# shift + alt - h : yabai -m window --swap west  || yabai -m window --display west  && yabai -m display --focus west
# shift + alt - j : yabai -m window --swap south || yabai -m window --display south && yabai -m display --focus south
# shift + alt - k : yabai -m window --swap north || yabai -m window --display north && yabai -m display --focus north
# shift + alt - l : yabai -m window --swap east  || yabai -m window --display east  && yabai -m display --focus east

# Manage window 
cmd + ctrl - e : yabai -m window --toggle split
cmd + ctrl - t : yabai -m window --toggle float 
cmd + ctrl - z : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
cmd + ctrl - f : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
cmd + ctrl - c : ~/.config/yabai/scripts/center_window.sh
cmd + ctrl - x : yabai -m window --close

# Modify window tree
ctrl + alt - 1 : yabai -m space --balance
ctrl + alt - 2 : yabai -m space --mirror x-axis
ctrl + alt - 3 : yabai -m space --mirror y-axis
ctrl + alt - 4 : yabai -m space --rotate 90

# App launchers
hyper - y : ~/.config/yabai/scripts/launch.sh yazi
hyper - b : ~/.config/yabai/scripts/launch.sh btop

cmd - m : :
cmd - h : :
