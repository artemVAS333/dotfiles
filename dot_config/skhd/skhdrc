# Create desktop, move window and follow focus 
hyper - d : yabai -m space --destroy
hyper - n : ~/.config/yabai/scripts/create_space.sh

# Change focus space
cmd + shift + ctrl - 1 : yabai -m space --focus 1  || yabai -m space --focus recent
cmd + shift + ctrl - 2 : yabai -m space --focus 2  || yabai -m space --focus recent
cmd + shift + ctrl - 3 : yabai -m space --focus 3  || yabai -m space --focus recent
cmd + shift + ctrl - 4 : yabai -m space --focus 4  || yabai -m space --focus recent                    
cmd + shift + ctrl - 5 : yabai -m space --focus 5  || yabai -m space --focus recent                    
cmd + shift + ctrl - 6 : yabai -m space --focus 6  || yabai -m space --focus recent                    
cmd + shift + ctrl - 7 : yabai -m space --focus 7  || yabai -m space --focus recent                    
cmd + shift + ctrl - 8 : yabai -m space --focus 8  || yabai -m space --focus recent                    
cmd + shift + ctrl - 9 : yabai -m space --focus 9  || yabai -m space --focus recent                    
cmd + shift + ctrl - 0 : yabai -m space --focus 10 || yabai -m space --focus recent

# Move focused window to space 
cmd + shift - 1 : yabai -m window --space 1  && yabai -m space --focus 1
cmd + shift - 2 : yabai -m window --space 2  && yabai -m space --focus 2
cmd + shift - 3 : yabai -m window --space 3  && yabai -m space --focus 3
cmd + shift - 4 : yabai -m window --space 4  && yabai -m space --focus 4
cmd + shift - 5 : yabai -m window --space 5  && yabai -m space --focus 5
cmd + shift - 6 : yabai -m window --space 6  && yabai -m space --focus 6
cmd + shift - 7 : yabai -m window --space 7  && yabai -m space --focus 7
cmd + shift - 8 : yabai -m window --space 8  && yabai -m space --focus 8
cmd + shift - 9 : yabai -m window --space 9  && yabai -m space --focus 9
cmd + shift - 0 : yabai -m window --space 10 && yabai -m space --focus 10

# Focus windows
cmd + shift + ctrl - h : yabai -m window --focus west   || yabai -m display --focus west
cmd + shift + ctrl - j : yabai -m window --focus south  || yabai -m display --focus south
cmd + shift + ctrl - k : yabai -m window --focus north  || yabai -m display --focus north
cmd + shift + ctrl - l : yabai -m window --focus east   || yabai -m display --focus east

# Move windows directionally / move floating window
cmd + shift - h : ~/.config/yabai/scripts/move_window.sh west
cmd + shift - j : ~/.config/yabai/scripts/move_window.sh south
cmd + shift - k : ~/.config/yabai/scripts/move_window.sh north
cmd + shift - l : ~/.config/yabai/scripts/move_window.sh east

# Resize windows
cmd + shift + alt - h : yabai -m window --resize right:-40:0 || yabai -m window --resize left:-40:0
cmd + shift + alt - j : yabai -m window --resize bottom:0:40|| yabai -m window --resize top:0:40
cmd + shift + alt - k : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40
cmd + shift + alt - l : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0

# Swap window
# shift + alt - h : yabai -m window --swap west  || yabai -m window --display west  && yabai -m display --focus west
# shift + alt - j : yabai -m window --swap south || yabai -m window --display south && yabai -m display --focus south
# shift + alt - k : yabai -m window --swap north || yabai -m window --display north && yabai -m display --focus north
# shift + alt - l : yabai -m window --swap east  || yabai -m window --display east  && yabai -m display --focus east

# Set insertion point in focused container
# fn + cmd - h : yabai -m window --insert west
# fn + cmd - j : yabai -m window --insert south
# fn + cmd - k : yabai -m window --insert north
# fn + cmd - l : yabai -m window --insert east

# Manage window 
ctrl + cmd - e : yabai -m window --toggle split
ctrl + cmd - t : yabai -m window --toggle float 

ctrl + cmd - f : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
ctrl + cmd - c : ~/.config/yabai/scripts/center_window.sh
ctrl + cmd - x : yabai -m window --close
# ctrl + cmd - m : ~/.config/yabai/scripts/toggle_minimize.sh

# Modify window tree
cmd + shift + alt - 1 : yabai -m space --balance
cmd + shift + alt - 2 : yabai -m space --mirror x-axis
cmd + shift + alt - 3 : yabai -m space --mirror y-axis
cmd + shift + alt - 4 : yabai -m space --rotate 90

# Manage window layout
# shift + alt - b : yabai -m space --layout bsp
# shift + alt - f : yabai -m space --layout float
# shift + alt - s : yabai -m space --layout stack

# App launchers
hyper - g : ~/.config/yabai/scripts/launch.sh ~/.config/yabai/scripts/launcher.sh launcher-term
hyper - y : ~/.config/yabai/scripts/launch.sh yazi
hyper - b : ~/.config/yabai/scripts/launch.sh btop

