# Create desktop, move window and follow focus 
hyper - d : yabai -m space --destroy
hyper - n : ~/.config/yabai/scripts/create_space.sh

# Change focus space
cmd + shift - i : yabai -m space --focus prev || yabai -m space --focus last
cmd + shift - o : yabai -m space --focus next || yabai -m space --focus first

cmd + shift - 1 : yabai -m space --focus 1  
cmd + shift - 2 : yabai -m space --focus 2  
cmd + shift - 3 : yabai -m space --focus 3  
cmd + shift - 4 : yabai -m space --focus 4 
cmd + shift - 5 : yabai -m space --focus 5  
cmd + shift - 6 : yabai -m space --focus 6  
cmd + shift - 7 : yabai -m space --focus 7  
cmd + shift - 8 : yabai -m space --focus 8  
cmd + shift - 9 : yabai -m space --focus 9  
cmd + shift - 0 : yabai -m space --focus 10 

# Move focused window to space 
cmd + shift + ctrl + alt - i : \
  target=$(yabai -m query --spaces --space | jq '.index') && \
  if [ "$target" -eq 1 ]; then \
    dest=$(yabai -m query --spaces | jq 'max_by(.index).index'); \
  else \
    dest=$((target - 1)); \
  fi && \
  yabai -m window --space $dest && \
  yabai -m space --focus $dest

cmd + shift + ctrl + alt - o : \
  target=$(yabai -m query --spaces --space | jq '.index') && \
  max=$(yabai -m query --spaces | jq 'max_by(.index).index') && \
  if [ "$target" -eq "$max" ]; then \
    dest=1; \
  else \
    dest=$((target + 1)); \
  fi && \
  yabai -m window --space $dest && \
  yabai -m space --focus $dest

cmd + shift + ctrl + alt - 1 : yabai -m window --space 1  && yabai -m space --focus 1
cmd + shift + ctrl + alt - 2 : yabai -m window --space 2  && yabai -m space --focus 2
cmd + shift + ctrl + alt - 3 : yabai -m window --space 3  && yabai -m space --focus 3
cmd + shift + ctrl + alt - 4 : yabai -m window --space 4  && yabai -m space --focus 4
cmd + shift + ctrl + alt - 5 : yabai -m window --space 5  && yabai -m space --focus 5
cmd + shift + ctrl + alt - 6 : yabai -m window --space 6  && yabai -m space --focus 6
cmd + shift + ctrl + alt - 7 : yabai -m window --space 7  && yabai -m space --focus 7
cmd + shift + ctrl + alt - 8 : yabai -m window --space 8  && yabai -m space --focus 8
cmd + shift + ctrl + alt - 9 : yabai -m window --space 9  && yabai -m space --focus 9
cmd + shift + ctrl + alt - 0 : yabai -m window --space 10 && yabai -m space --focus 10

# Focus windows
cmd + shift + ctrl - h : yabai -m window --focus west   || yabai -m display --focus west
cmd + shift + ctrl - j : yabai -m window --focus south  || yabai -m display --focus south
cmd + shift + ctrl - k : yabai -m window --focus north  || yabai -m display --focus north
cmd + shift + ctrl - l : yabai -m window --focus east   || yabai -m display --focus east

# Move windows directionally / move floating window
cmd + shift + ctrl + alt - h : ~/.config/yabai/scripts/move_window.sh west
cmd + shift + ctrl + alt - j : ~/.config/yabai/scripts/move_window.sh south
cmd + shift + ctrl + alt - k : ~/.config/yabai/scripts/move_window.sh north
cmd + shift + ctrl + alt - l : ~/.config/yabai/scripts/move_window.sh east

# Resize windows
cmd + shift + alt - h : yabai -m window --resize right:-40:0 || yabai -m window --resize left:-40:0
cmd + shift + alt - j : yabai -m window --resize bottom:0:40|| yabai -m window --resize top:0:40
cmd + shift + alt - k : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40
cmd + shift + alt - l : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0

# Swap window
# shift + alt - h : yabai -m window --swap west  || yabai -m window --display west  && yabai -m display --focus west
# shift + alt - j : yabai -m window --swap south || yabai -m window --display south && yabai -m display --focus south
# shift + alt - k : yabai -m window --swap north || yabai -m window --display north && yabai -m display --focus north
# shift + alt - l : yabai -m window --swap east  || yabai -m window --display east  && yabai -m display --focus east

# Manage window 
ctrl + cmd - e : yabai -m window --toggle split
ctrl + cmd - t : yabai -m window --toggle float 

ctrl + cmd - f : yabai -m window --grid 1:1:0:0:1:1 || yabai -m window --toggle zoom-fullscreen
ctrl + cmd - c : ~/.config/yabai/scripts/center_window.sh
ctrl + cmd - x : yabai -m window --close
# ctrl + cmd - m : ~/.config/yabai/scripts/toggle_minimize.sh

# Modify window tree
# cmd + shift + alt - 1 : yabai -m space --balance
# cmd + shift + alt - 2 : yabai -m space --mirror x-axis
# cmd + shift + alt - 3 : yabai -m space --mirror y-axis
# cmd + shift + alt - 4 : yabai -m space --rotate 90

# App launchers
hyper - g : ~/.config/yabai/scripts/launch.sh ~/.config/yabai/scripts/launcher.sh launcher-term
hyper - y : ~/.config/yabai/scripts/launch.sh yazi
hyper - b : ~/.config/yabai/scripts/launch.sh btop

