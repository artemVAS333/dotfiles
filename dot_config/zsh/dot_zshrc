if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if [[ -f "${ZDOTDIR:-$HOME/.config/zsh}/lib/helpers.zsh" ]]; then
  source "$ZDOTDIR/lib/helpers.zsh"
fi

# Load modular configurations
try_source "$ZDOTDIR/conf.d/env.zsh"
try_source "$ZDOTDIR/conf.d/lang.zsh"
try_source "$ZDOTDIR/conf.d/dump.zsh"
try_source "$ZDOTDIR/conf.d/history.zsh"
try_source "$ZDOTDIR/conf.d/less.zsh"
try_source "$ZDOTDIR/conf.d/completion.zsh"
try_source "$ZDOTDIR/conf.d/glob.zsh"
try_source "$ZDOTDIR/conf.d/display.zsh"

# Path Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

# Plugins
try_source "$ZDOTDIR/conf.d/plugins.zsh"

# Oh My Zsh configuration
try_source "$ZSH/oh-my-zsh.sh"

# User configuration
try_source "$ZDOTDIR/conf.d/aliases.zsh"

try_source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
try_source "$ZDOTDIR/conf.d/p10k.zsh"

try_eval fnm env --use-on-cd --shell zsh
try_eval zoxide init zsh

